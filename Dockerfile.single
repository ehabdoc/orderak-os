# Single-container image for one-URL hosts (Render / Railway / Fly).
# Serves the API + the built web UI from the same process/port.
# The API serves /api/* and static files when SERVE_WEB=true.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN npm install --workspaces --include-workspace-root
COPY . .
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma
RUN npm run build -w apps/api
RUN npm run build -w apps/web

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV SERVE_WEB=true
ENV WEB_DIST=/app/web-dist
ENV DATABASE_URL=file:/app/data/orderak.db
ENV PORT=10000

COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/web/dist ./web-dist
COPY --from=build /app/node_modules ./node_modules
COPY apps/api/docker-entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint && mkdir -p /app/data
VOLUME ["/app/data"]

EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-10000}/health || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["node", "apps/api/dist/index.js"]
